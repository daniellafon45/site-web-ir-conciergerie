# Configuration SMTP Hostinger pour l'envoi des soumissions
# Copier ce fichier en .env et remplir SMTP_PASS avec le mot de passe réel.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=direction@ir-immigration.com
SMTP_PASS=REMPLACER_PAR_MOT_DE_PASSE
EMAIL_FROM=IR Conciergerie <direction@ir-immigration.com>

# Les soumissions sont envoyées à direction@ir-immigration.com (voir src/lib/soumission.constants.ts)
# Compte SMTP validé : direction@ir-immigration.com sur port 587 (STARTTLS)
