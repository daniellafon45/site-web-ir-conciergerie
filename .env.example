# --- Développement local (SMTP Hostinger) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=direction@ir-immigration.com
SMTP_PASS=REMPLACER_PAR_MOT_DE_PASSE
EMAIL_FROM=IR Conciergerie <conciergerie@ir-immigration.com>

# --- Production Cloudflare (obligatoire — SMTP bloqué sur Workers) ---
# Clé API : https://resend.com → vérifier le domaine ir-immigration.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Les soumissions sont envoyées à direction@ir-immigration.com (voir src/lib/soumission.constants.ts)
